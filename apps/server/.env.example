# Use GEMINI_API_KEY_1 (or legacy GEMINI_API_KEY) for the first key.
# Optional additional keys use process-wide round-robin selection
# and move to the next key when Gemini reports a rate/quota limit.
GEMINI_API_KEY_1=your-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.1-flash-lite
